# ============================================================
# KPS Smart Buchhaltung – Umgebungsvariablen
#
# Kopiere diese Datei zu ".env.local" und trage dort deine Werte ein.
# .env.local ist in .gitignore und bleibt lokal.
#
# In diese Datei gehören AUSSCHLIESSLICH Platzhalter. Sie liegt im
# Repository – ein echter Schlüssel hier ist ein veröffentlichter
# Schlüssel, auch bei einem privaten Repository.
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# supabase.com → Projekt → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key-hier

# Umgeht sämtliche Zugriffsregeln – nur serverseitig verwenden,
# niemals mit NEXT_PUBLIC_ davor.
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key-hier


# ── Adresse der Anwendung ───────────────────────────────────
# Basis für Links in versendeten E-Mails.
# Lokal:      http://localhost:3000
# Produktion: die echte Domain, nicht localhost
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ── E-Mail-Versand (Resend) ─────────────────────────────────
# resend.com → API Keys. Die Absenderdomäne muss dort verifiziert sein.
RESEND_API_KEY=re_dein-resend-key-hier
RESEND_FROM_EMAIL="Rechnung <office@deine-domain.at>"


# ── Belegerkennung (Anthropic) ──────────────────────────────
# console.anthropic.com → API Keys. Beginnt mit "sk-ant-api03-".
ANTHROPIC_API_KEY=sk-ant-dein-anthropic-key-hier


# ── FinanzOnline WebService (Phase 3, noch nicht angebunden) ─
# FO_WS_USER=
# FO_WS_PIN=
# FO_WS_URL=https://finanzonline.bmf.gv.at/fon/ws/...
